# Ensure shell scripts, systemd units and Debian/RPM control files keep LF
# line endings. CRLF breaks dpkg-deb ("blank line in value of field
# 'Description'"), rpmbuild ("%prep: : not found") and shebang lines.
* text=auto eol=lf

*.sh text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.service text eol=lf
*.spec text eol=lf
control text eol=lf
postinst text eol=lf
prerm text eol=lf
postrm text eol=lf
Containerfile text eol=lf

# Windows-only scripts keep CRLF for the PowerShell/cmd interpreters.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.apk binary
*.deb binary
*.rpm binary
*.exe binary
*.jar binary
*.png binary
*.zip binary
*.jks binary
*.keystore binary
